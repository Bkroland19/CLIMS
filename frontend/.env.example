# Copy to `.env.local` for local development.

# Where `npm run dev` forwards /api, /docs and /health. Server-side only; the
# browser always calls this app's own origin. Defaults to the Nginx gateway.
# Point it at the mock API (http://127.0.0.1:8787) to work without a backend.
BACKEND_URL=http://localhost:8080

# Next.js inlines every NEXT_PUBLIC_* value into the public bundle at build
# time, so nothing below may be a secret.

# Base URL the browser calls for the API. Leave as `/api/v1` when the app is served
# behind the repo's Nginx gateway or the dev rewrites above; use an absolute URL
# only when the API lives on another origin and allows this one via CORS.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# The hotspot map's base layer. Empty uses OpenStreetMap's community tiles, which
# their usage policy allows for light use; "off" draws none (offline demos, tests);
# or an https://…/{z}/{x}/{y}.png template for a tile server of your own, credited
# with NEXT_PUBLIC_MAP_ATTRIBUTION.
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_ATTRIBUTION=
