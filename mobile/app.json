{
  "expo": {
    "name": "CLIMS",
    "slug": "clims-app",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lmd",
    "userInterfaceStyle": "automatic",
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.moh.last_mile_condom_distribution",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 192,
          "resizeMode": "contain",
          "backgroundColor": "#f7faf3",
          "dark": {
            "image": "./assets/images/splash-logo-dark.png",
            "backgroundColor": "#10140f"
          },
          "ios": {
            "backgroundColor": "#f2f2f7",
            "dark": {
              "backgroundColor": "#000000"
            }
          },
          "android": {
            "backgroundColor": "#f7faf3",
            "dark": {
              "backgroundColor": "#10140f"
            }
          }
        }
      ],
      "expo-build-properties"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "d680bffa-d623-48a1-b8b8-aea07cfc200c"
      },
      "releaseVersion": "2.2.1"
    },
    "owner": "wafula3"
  }
}
