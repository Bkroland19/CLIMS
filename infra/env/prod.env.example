# Copy to prod.env and supply deployment credentials; blank secrets fail validation.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=clims_db
DB_USER=clims_user
DB_PASSWORD=
DB_SSLMODE=disable
PORT=8080
JWT_SECRET=
# Portal sign-in through MoH Keycloak (see infra/sso/README.md). Leave OIDC_CLIENT_ID blank to offer
# password sign-in only.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PUBLIC_ORIGIN=
IDENTITY_SYNC_CLIENT_ID=
# production (the default when unset). Never set IDENTITY_SYNC_TEST_PROBE here: the backend refuses
# to start with it in production.
APP_ENV=production
# Optional: IPs or CIDR ranges allowed to send the API the client address (X-Real-IP). Empty trusts
# the private container network, where nginx reaches the API. A load balancer in front of nginx is
# configured in nginx instead (set_real_ip_from), so nginx passes on the real client address.
TRUSTED_PROXIES=
# Optional: push notifications to the field app. The Firebase service account key (Project settings
# → Service accounts → Generate new private key), base64-encoded on one line: base64 -w0 key.json.
# Raw JSON on one line also works. Empty disables push; notifications still reach the in-app inbox.
FIREBASE_CREDENTIALS_JSON=
NGINX_PORT=8088
BIND_ADDRESS=127.0.0.1
# Required only when building mobile release JavaScript artifacts.
EXPO_PUBLIC_API_URL=
# The hotspot map's base layer. Empty uses OpenStreetMap's community tiles (fine for light use);
# "off" draws none; or an https://…/{z}/{x}/{y}.png template for your own tile server, credited
# with NEXT_PUBLIC_MAP_ATTRIBUTION. Not secrets: both are sent to every visitor.
NEXT_PUBLIC_MAP_TILES=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# SeaweedFS object storage (S3 API); blank values fail validation.
S3_ACCESS_KEY=
S3_SECRET_KEY=
