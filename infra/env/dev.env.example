DB_HOST=localhost
DB_PORT=5432
DB_NAME=clims_db
DB_USER=clims_user
DB_PASSWORD=clims_password
DB_SSLMODE=disable
PORT=8080
JWT_SECRET=local-development-only-change-before-deployment
# development or test permits IDENTITY_SYNC_TEST_PROBE=1; unset means production.
APP_ENV=development

# Nginx gateway and Expo Metro development server
NGINX_PORT=8080
METRO_PORT=19000
BIND_ADDRESS=127.0.0.1
MOBILE_HOST=localhost
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
# Browser key for the web app's hotspot map; restrict it by HTTP referrer. Optional, and not a
# secret: it is sent to every visitor.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# SeaweedFS object storage (S3 API on localhost:8333 in development)
S3_ACCESS_KEY=clims
S3_SECRET_KEY=local-development-only-change-before-deployment
