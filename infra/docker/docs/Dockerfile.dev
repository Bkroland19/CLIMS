# Docusaurus dev server with live reload, served under /handbook/ behind the gateway Nginx.
FROM node:22-alpine
WORKDIR /app/website
COPY website/package.json website/package-lock.json ./
RUN npm ci
EXPOSE 3000
# Refresh the dependency volume when a source-mounted lockfile changes. Polling picks up edits
# through Docker Desktop bind mounts, which do not deliver file events.
CMD ["sh", "-c", "npm ci --prefer-offline && exec npx docusaurus start --host 0.0.0.0 --port 3000 --no-open --poll 1000"]
