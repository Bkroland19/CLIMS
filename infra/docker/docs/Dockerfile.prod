# Static Docusaurus build of docs/, served under /handbook/ behind the gateway Nginx.
FROM node:22-alpine AS builder
WORKDIR /app/website
COPY website/package.json website/package-lock.json ./
RUN npm ci
COPY VERSION /app/VERSION
COPY docs /app/docs
COPY website/ ./
ARG VERSION
# The deployed API URL is on the same host as the site; its origin becomes the canonical site URL.
ARG EXPO_PUBLIC_API_URL=
RUN test -z "$VERSION" || test "$VERSION" = "$(cat /app/VERSION)"
RUN DOCS_SITE_URL="$(node -p "process.argv[1] ? new URL(process.argv[1]).origin : ''" "$EXPO_PUBLIC_API_URL")" \
  npm run build

FROM nginx:1.30-alpine
COPY infra/nginx/docs.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/website/build /usr/share/nginx/html/handbook
EXPOSE 80
